[Unit]
Description=The gunicorn service that runs the VALD VAMDC node, observed lines
After=network.target

[Service]
User=vamdc
Group=vamdc
WorkingDirectory=/opt/ValdNode/nodes/vald
Environment="DJANGO_SETTINGS_MODULE=settings_obs"
ExecStart=/opt/ValdNode/.venv/bin/gunicorn wsgi:application -w 4 -t 300 -b unix:/run/vamdc-obs/vald_obs.socket
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
PrivateTmp=true
Restart=always
RuntimeDirectory=vamdc-obs
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
