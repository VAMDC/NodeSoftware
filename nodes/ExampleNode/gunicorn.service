# systemd unit that runs the node with gunicorn. Adapt the paths and the name
# "yournode", copy it to /etc/systemd/system/yournode.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now yournode
[Unit]
Description=VAMDC node yournode (gunicorn)
After=network.target

[Service]
User=vamdc
Group=vamdc
WorkingDirectory=/opt/NodeSoftware/nodes/YourNode
Environment="DJANGO_SETTINGS_MODULE=settings"
# -w: worker processes, each answers one query at a time
# -t: seconds before a worker on a long query is killed; keep the proxy's
#     timeout at least as long
ExecStart=/opt/NodeSoftware/.venv/bin/gunicorn wsgi:application -w 4 -t 300 -b unix:/run/yournode/gunicorn.sock
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
PrivateTmp=true
# systemd creates /run/yournode for the socket and removes it on stop
RuntimeDirectory=yournode
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
